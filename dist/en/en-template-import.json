  "name": "GLAAD Email Template",
  "type": "BROADCAST",
  "content": "<!doctype html>\n<html lang=\"en\" dir=\"auto\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<!-- GLAAD Email Template -->\n<meta name=\"color-scheme\" content=\"light dark\" />\n<meta name=\"supported-color-schemes\" content=\"light dark\" />\n<meta name=\"format-detection\" content=\"telephone=no\" />\n<!--[if !mso]><!-->\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<!--<![endif]-->\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<!--[if mso]>\n    <noscript>\n    <xml>\n    <o:OfficeDocumentSettings>\n      <o:AllowPNG/>\n      <o:PixelsPerInch>96</o:PixelsPerInch>\n    </o:OfficeDocumentSettings>\n    </xml>\n    </noscript>\n    <![endif]-->\n<!--[if lte mso 11]>\n    <style type=\"text/css\">\n      .mj-outlook-group-fix { width:100% !important; }\n    </style>\n    <![endif]-->\n<style type=\"text/css\" data-en-tools-template-css>\n    .wysiwyg div p:first-child,\n    .wysiwyg div h1:first-child,\n    .wysiwyg div h2:first-child,\n    .wysiwyg div h3:first-child,\n    .wysiwyg div h4:first-child,\n    .wysiwyg div h5:first-child,\n    .wysiwyg div h6:first-child,\n    .wysiwyg div ul:first-child,\n    .wysiwyg div ol:first-child {\n      margin-top: 0;\n    }\n\n    .wysiwyg div p:last-child,\n    .wysiwyg div h1:last-child,\n    .wysiwyg div h2:last-child,\n    .wysiwyg div h3:last-child,\n    .wysiwyg div h4:last-child,\n    .wysiwyg div h5:last-child,\n    .wysiwyg div h6:last-child,\n    .wysiwyg div ul:last-child,\n    .wysiwyg div ol:last-child {\n      margin-bottom: 0;\n    }\n\n    .dark-only {\n      display: none;\n    }\n\n    :root {\n      color-scheme: light dark;\n      supported-color-schemes: light dark;\n    }\n\n    @media only screen and (max-width: 9999px) {\n      [data-ogsc] .dark-only {\n        display: block !important;\n      }\n\n      [data-ogsc] .light-only {\n        display: none !important;\n      }\n    }\n\n    @media (prefers-color-scheme: dark) {\n      .light-only {\n        display: none !important;\n      }\n\n      .dark-only {\n        display: block !important;\n      }\n    }\n\n  </style>\n<style type=\"text/css\" data-en-tools-band>\n    div[data-container] {\n      max-width: 600px;\n      margin: 0 auto;\n    }\n\n    [data-container=\"main\"]:before {\n      content: \"Email Template\";\n      display: block !important;\n      font-weight: 700 !important;\n      font-family: sans-serif !important;\n      color: #4e535c !important;\n      line-height: 1.75rem !important;\n      text-align: center !important;\n      margin-bottom: 2rem !important;\n      background-color: #d0d5dd !important;\n    }\n\n    :is(body):has(.en__emailbuilder__block) .marketing-tools-banner {\n      display: flex !important;\n      font-weight: 700 !important;\n      font-family: sans-serif !important;\n      color: #4e535c !important;\n      line-height: 2rem !important;\n      top: 1.75rem !important;\n      width: 100% !important;\n      max-width: 600px !important;\n      justify-content: center !important;\n      background-color: #d0d5dd !important;\n    }\n\n    :is(body):has(.en__emailbuilder__block) #head-styles {\n      position: absolute !important;\n    }\n\n  </style>\n<style type=\"text/css\" data-en-tools-band>{replacement~debug_helper}</style></head>\n<body class=\"email-body\" style=\"word-spacing:normal;background-color:{replacement~background_color};\">\n<div aria-roledescription=\"email\" role=\"article\" lang=\"en\" dir=\"auto\" style=\"word-spacing:normal;background-color:{replacement~background_color};\">\n<div style=\"color:#000000;background-color:{replacement~background_color};margin:0;padding:0;\">\n<div class=\"email-ground\" style=\"background-color:{replacement~background_color};margin:0;padding:0;\"><!-- START: Main Content -->{{container~main}}<!-- END: Main Content -->\n</div>\n</div>\n</div>\n</body>\n</html>\n",
  "data": "{\"design\":[{\"name\":\"main\",\"blocks\":[]}],\"replacements\":{\"background_color\":{\"type\":\"Select\",\"values\":{\"default\":{\"value\":\"#dedede\"}},\"order\":0,\"label\":\"Background Color\",\"name\":\"background_color\",\"section\":\"Template\",\"options\":[{\"value\":\"#111111\",\"label\":\"Near Black - #111111\"},{\"value\":\"#454545\",\"label\":\"Charcoal - #454545\"},{\"value\":\"#0b4280\",\"label\":\"Navy - #0b4280\"},{\"value\":\"#0313c4\",\"label\":\"CTA Blue - #0313c4\"},{\"value\":\"#105bab\",\"label\":\"Blue - #105bab\"},{\"value\":\"#ff3131\",\"label\":\"Red - #ff3131\"},{\"value\":\"#ff7272\",\"label\":\"Light Red - #ff7272\"},{\"value\":\"#008dd0\",\"label\":\"Azure - #008dd0\"},{\"value\":\"#00afdf\",\"label\":\"Alt Cyan - #00afdf\"},{\"value\":\"#00b2e3\",\"label\":\"Cyan - #00b2e3\"},{\"value\":\"#5dcbeb\",\"label\":\"Light Cyan - #5dcbeb\"},{\"value\":\"#dedede\",\"label\":\"Light Gray - #dedede (default)\"},{\"value\":\"#ffffff\",\"label\":\"White - #ffffff\"}]},\"debug_helper\":{\"type\":\"Select\",\"values\":{\"default\":{\"value\":\"\"}},\"order\":1,\"label\":\"Debug Helper\",\"name\":\"debug_helper\",\"section\":\"Template\",\"options\":[{\"value\":\"\",\"label\":\"Off (default)\"},{\"value\":\":is(body):has(.en__emailbuilder__block) .marketing-tools-block-band{\\n    display: flex !important;\\n    font-weight: 700 !important;\\n    font-family: sans-serif !important;\\n    color: #4e535c !important;\\n    line-height: 2rem !important;\\n    width: 100% !important;\\n    max-width: 600px !important;\\n    justify-content: center !important;\\n    background-color: #d0d5dd !important;\\n  }\",\"label\":\"On: show block names and versions in the builder\"}]}}}"
}